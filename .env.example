# Copy of the variables used by docker-compose.yml. Generate real local values with scripts/init-local-env.sh.
# Never commit a populated .env file.

# --- Database (local container) ---
POSTGRES_SUPERUSER_PASSWORD=change-me
MEDASSIST_DB_OWNER_PASSWORD=change-me
MEDASSIST_DB_APP_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# --- Identity provider (local Keycloak) ---
KEYCLOAK_ADMIN_PASSWORD=change-me
MEDASSIST_DEMO_USER_PASSWORD=change-me

# --- Ports (all bound to 127.0.0.1) ---
# POSTGRES_PORT=5432
# KEYCLOAK_PORT=8180
# BACKEND_PORT=8081
# FRONTEND_PORT=4173
# PROMETHEUS_PORT=9090

# --- AI provider: none | openai | azure-openai | openai-compatible ---
AI_PROVIDER=none
# AI_RESPONSE_FORMAT=json_object        # json_object | json_schema (strict structured outputs where supported)
# AI_TIMEOUT=90s
# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=
# Local OpenAI-compatible server (Ollama, vLLM, LM Studio)
# LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_LLM_MODEL=
# LOCAL_LLM_API_KEY=

# --- Embeddings: local-hashing (offline, dev only) | openai | azure-openai | openai-compatible ---
EMBEDDING_PROVIDER=local-hashing
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=

# --- Misc ---
DEMO_SEED_ENABLED=true
# TRACING_EXPORT_ENABLED=false
